---
import "../styles/global.css";
import { curator } from "../data/skills";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Marketing Skills | Open-source marketing operators for AI agents",
  description = "Open-source operators for SEO, brand positioning, content, growth, GTM and self-hosted funnels. Built for Claude Code, Codex, Gemini, OpenCode and other AI agents.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Marketing Skills",
  url: "https://marketingskills.net",
  description: "Open-source marketing operators for AI agents.",
  sameAs: ["https://github.com/marketingskills"],
  founder: {
    "@type": "Person",
    "@id": curator.personId,
    name: curator.name,
    url: curator.about,
    sameAs: [curator.linkedin, curator.github, curator.youtube],
  },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">Marketing Skills</a>
        <nav aria-label="Main navigation">
          <a href="/skills/">Skills</a>
          <a href="/catalog.json">API</a>
          <a href={curator.website}>Consulting</a>
          <a href="https://github.com/marketingskills">GitHub ↗</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <div class="wrap footer-inner">
        <p>
          Open-source marketing operators for AI agents. Created and curated by{" "}
          <a href={curator.about}>{curator.name}</a>.
        </p>
        <div>
          <a href="/skills/">Catalogue</a>
          <a href="/llms.txt">llms.txt</a>
          <a href={curator.website}>UK SEO &amp; AEO</a>
          <a href="https://github.com/marketingskills">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
